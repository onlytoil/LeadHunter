# Application
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/leadhunter?schema=public

# Keep false until TELEGRAM_API_ID, TELEGRAM_API_HASH and TELEGRAM_SESSION exist.
TELEGRAM_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Comma-separated @usernames or numeric chat/channel IDs.
TELEGRAM_CHATS=@example_chat,-1001234567890

# Comma-separated phrases; matching is case-insensitive and supports RU/EN.
TELEGRAM_INCLUDE_KEYWORDS=ищу разработчика,нужен сайт,looking for a developer,need a website
TELEGRAM_EXCLUDE_KEYWORDS=вакансия,бесплатно,job opening,free only

# Create a bot with @BotFather and send it one message before using your chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFICATION_CHAT_ID=
